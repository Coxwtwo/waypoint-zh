    <!-- Quiz -->
    <string name="quiz_title">Какой метод подойдёт?</string>
    <string name="quiz_step">Вопрос %1$d из %2$d</string>
    <string name="quiz_q1">Какая у тебя цель?</string>
    <string name="quiz_q1_dream">Большая мечта, у которой много сторон</string>
    <string name="quiz_q1_number">Результат, который можно измерить</string>
    <string name="quiz_q1_habit">Новая привычка или практика</string>
    <string name="quiz_q1_project">Проект со сроком</string>
    <string name="quiz_q1_unsure">Пока не знаю, чего хочу</string>
    <string name="quiz_q2">Можно ли измерить её числом?</string>
    <string name="quiz_q2_yes">Да: килограммы, деньги, страницы, минуты</string>
    <string name="quiz_q2_no">Не очень</string>
    <string name="quiz_q3">Как далеко до неё?</string>
    <string name="quiz_q3_weeks">Несколько недель</string>
    <string name="quiz_q3_quarter">Около трёх месяцев</string>
    <string name="quiz_q3_year">Год или больше</string>
    <string name="quiz_q4">Что обычно мешает?</string>
    <string name="quiz_q4_focus">Отвлекаюсь на другое</string>
    <string name="quiz_q4_delay">Откладываю на потом</string>
    <string name="quiz_q4_give_up">Бросаю, когда становится трудно</string>
    <string name="quiz_q4_overwhelm">Всего слишком много</string>
    <string name="quiz_q4_start">Не знаю, с чего начать</string>
    <string name="quiz_q5">Сколько нужно структуры?</string>
    <string name="quiz_q5_lot">Много: планы, цифры, проверки</string>
    <string name="quiz_q5_little">Немного: чем легче, тем лучше</string>

    <string name="quiz_result_title">Тебе подойдут эти два</string>
    <string name="quiz_best">Лучше всего</string>
    <string name="quiz_because">Почему: %s.</string>
    <string name="quiz_start_with">Начать: %s</string>
    <string name="quiz_about">Подробнее</string>
    <string name="quiz_again">Пройти заново</string>
    <string name="quiz_tools_title">Сначала выбери цель</string>
    <string name="quiz_tools_text">Пока сама цель не ясна, метод не поможет. Эти инструменты помогут понять, чего на самом деле хочется.</string>
    <string name="quiz_or_start">Или начни сразу</string>
    <string name="quiz_lens_title">Добавь линзу</string>
    <string name="quiz_lens_woop">Если бросаешь или откладываешь, WOOP заранее готовит план «если–то» как раз на такой момент.</string>
    <string name="quiz_lens_smart">Сначала нужна ясная формулировка. SMART превратит расплывчатое желание в цель, которую можно проверить.</string>
    <string name="quiz_lens_premortem">На долгой дороге много мест, где можно споткнуться. Пре-мортем найдёт их заранее.</string>
    <string name="quiz_lens_whys">В долгом пути важно помнить, ради чего всё началось. Пять «почему» найдут настоящую причину.</string>

    <string name="quiz_why_dream">большую цель проще держать, когда вся картина на одном листе</string>
    <string name="quiz_why_number">результат — число, а этот метод построен на числах</string>
    <string name="quiz_why_habit">практика лучше всего растёт маленькими ежедневными шагами</string>
    <string name="quiz_why_project">проект со сроком проще всего планировать от финиша</string>
    <string name="quiz_why_unsure">он достаточно лёгкий, чтобы начать, пока цель ещё складывается</string>
    <string name="quiz_why_measurable">цель можно измерить, и прогресс будет виден в цифрах</string>
    <string name="quiz_why_not_measurable">он хорошо подходит для целей, которые трудно выразить числом</string>
    <string name="quiz_why_weeks">он рассчитан на короткий срок в несколько недель</string>
    <string name="quiz_why_quarter">он рассчитан примерно на три месяца</string>
    <string name="quiz_why_year">он выдерживает долгую дорогу в год и больше</string>
    <string name="quiz_why_focus">он держит на одном главном, когда внимание расползается</string>
    <string name="quiz_why_delay">близкие сроки не оставляют места для «потом»</string>
    <string name="quiz_why_give_up">от маленьких шагов трудно отказаться</string>
    <string name="quiz_why_overwhelm">он разбивает большую цель на части, которые не пугают</string>
    <string name="quiz_why_start">он показывает, что делать в первую очередь</string>
    <string name="quiz_why_structured">он даёт ту структуру, которую ты любишь</string>
    <string name="quiz_why_light">он лёгкий, как тебе и нравится</string>
</resources>
