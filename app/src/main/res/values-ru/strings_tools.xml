    <!-- Wheel of life -->
    <string name="wheel_intro">Оцени каждую сферу жизни от 1 до 10 — как есть сейчас, а не как должно быть. Неправильных ответов нет.</string>
    <string name="wheel_average">В среднем %s</string>
    <string name="wheel_comparing">Контур: оценка от %1$s, в среднем %2$s</string>
    <string name="wheel_rate">Как сейчас?</string>
    <string name="wheel_save">Сохранить оценку</string>
    <string name="wheel_saved">На сегодня сохранено</string>
    <string name="wheel_lowest">Где цель поможет больше всего</string>
    <string name="wheel_lowest_text">Самые низкие сферы. Даже одна небольшая цель здесь подтянет всё колесо.</string>
    <string name="wheel_score">%d из 10</string>
    <string name="wheel_goal_here">Поставить цель</string>
    <string name="wheel_history">Прошлые оценки</string>
    <string name="wheel_history_hint">Нажми на оценку, чтобы сравнить её с колесом сверху.</string>

    <!-- Odyssey plans -->
    <string name="ody_intro">Представь три разные версии своих следующих пяти лет. Не ищи правильную: каждая — настоящая возможность.</string>
    <string name="ody_life_n">Жизнь %d</string>
    <string name="ody_life1">Нынешний путь</string>
    <string name="ody_life2">Если этот путь исчезнет</string>
    <string name="ody_life3">Если деньги не важны</string>
    <string name="ody_life1_text">Куда через пять лет приведёт то, чем ты занимаешься сейчас? Представь в подробностях.</string>
    <string name="ody_life2_text">Нынешний путь вдруг закрылся. Чем тогда заняться?</string>
    <string name="ody_life3_text">Деньги, статус и чужое мнение не имеют значения. Какой была бы твоя жизнь?</string>
    <string name="ody_sketch">Набросать эту жизнь</string>
    <string name="ody_headline">Заголовок</string>
    <string name="ody_headline_hint">Шесть слов об этой жизни</string>
    <string name="ody_story">Что происходит за пять лет</string>
    <string name="ody_story_hint">Работа, дом, люди, чему учишься</string>
    <string name="ody_resources">Ресурсы</string>
    <string name="ody_like">Нравится</string>
    <string name="ody_confidence">Уверенность</string>
    <string name="ody_coherence">Цельность</string>
    <string name="ody_compare">Рядом</string>
    <string name="ody_total">в ср. %d</string>
    <string name="ody_compare_hint">Выше всех оценена жизнь %d. Но оценки — не приговор: заметь, о какой жизни думаешь чаще.</string>
    <string name="ody_delete">Удалить эту жизнь?</string>
    <string name="ody_delete_text">Набросок и оценки удалятся.</string>

    <!-- 5/25 -->
    <string name="buf_intro">Запиши 25 вещей, которых хочешь, больших и маленьких. Потом выбери пять самых важных.</string>
    <string name="buf_written">Записано %1$d из %2$d</string>
    <string name="buf_chosen">Выбрано %1$d из %2$d</string>
    <string name="buf_add">Добавить цель</string>
    <string name="buf_empty">Начни список. Подходит всё, чего хочется: в работе, в жизни, для себя.</string>
    <string name="buf_top">Пятёрка</string>
    <string name="buf_top_empty">Нажми на звезду рядом с целью, чтобы взять её в пятёрку.</string>
    <string name="buf_top_full">Пятёрка уже собрана. Сначала убери одну звезду.</string>
    <string name="buf_list">Всё остальное</string>
    <string name="buf_list_text">Нажми на звезду, чтобы взять цель в пятёрку.</string>
    <string name="buf_avoid">Избегать любой ценой</string>
    <string name="buf_avoid_text">Это не запасной список. Эти цели достаточно важны, чтобы красть время у пятёрки, поэтому пока не трогай их.</string>
