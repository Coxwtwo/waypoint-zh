    <!-- SMART -->
    <string name="smart_s">Чего именно ты хочешь?</string>
    <string name="smart_s_hint">Конкретность. Кто, что, где. Замени размытые слова точными.</string>
    <string name="smart_s_example">пробежать марафон в своём городе, а не просто «прийти в форму»</string>
    <string name="smart_m">Как понять, что цель достигнута?</string>
    <string name="smart_m_hint">Измеримость. Число, факт, то, что можно проверить.</string>
    <string name="smart_m_example">пробежать 42,2 км быстрее чем за 4 часа</string>
    <string name="smart_a">Это реально с тем, что у тебя есть?</string>
    <string name="smart_a_hint">Достижимость. Время, деньги, здоровье, навыки. Что сделает цель выполнимой?</string>
    <string name="smart_a_example">я уже бегаю 10 км, у меня есть полгода и четыре утра в неделю</string>
    <string name="smart_r">Почему это и почему сейчас?</string>
    <string name="smart_r_hint">Значимость. Как цель связана с твоей жизнью и другими целями.</string>
    <string name="smart_r_example">хочу доказать себе, что довожу начатое до конца</string>
    <string name="smart_t">К какому сроку?</string>
    <string name="smart_t_hint">Срок. С датой цель становится настоящей. Эту дату можно сразу поставить сроком цели.</string>
    <string name="smart_t_example">городской марафон 20 апреля</string>
    <string name="smart_meter">Отвечено %d из 5</string>
    <string name="smart_deadline">Срок цели</string>
    <string name="smart_no_deadline">Не задан</string>
    <string name="smart_set_deadline">Поставить срок</string>
    <string name="smart_change_deadline">Изменить срок</string>
    <string name="smart_wording">Теперь одной фразой</string>
    <string name="smart_wording_hint">Собери ответы в одно ясное предложение.</string>
    <string name="smart_wording_placeholder">Цель, чётко</string>
    <string name="smart_wording_example">Пробежать городской марафон 20 апреля быстрее чем за 4 часа</string>
    <string name="smart_use_title">Сделать названием цели</string>
    <string name="smart_is_title">Теперь цель называется так.</string>

    <!-- WOOP -->
    <string name="woop_wish">Чего ты хочешь?</string>
    <string name="woop_wish_hint">Желание. Что-то непростое, но возможное. Хватит пары слов.</string>
    <string name="woop_wish_example">пробежать первый марафон</string>
    <string name="woop_outcome">Какой исход был бы лучшим?</string>
    <string name="woop_outcome_hint">Результат. Что ты почувствуешь, что изменится?</string>
    <string name="woop_outcome_pause">Удели этому минуту. Закрой глаза и представь лучший исход как можно ярче: где ты, что видишь, что чувствуешь. Потом запиши.</string>
    <string name="woop_outcome_example">пересекаю финиш, родные кричат, и я чувствую, что трудное мне по силам</string>
    <string name="woop_obstacle">Что внутри тебя может помешать?</string>
    <string name="woop_obstacle_hint">Препятствие. Не погода и не другие люди, а твоя привычка, чувство или мысль.</string>
    <string name="woop_obstacle_pause">Теперь представь момент, когда обычно всё срывается. Что ты в этот момент чувствуешь или думаешь? Назови главное препятствие.</string>
    <string name="woop_obstacle_example">после работы я устаю и говорю себе, что побегу завтра</string>
    <string name="woop_plan">Что ты сделаешь, когда оно появится?</string>
    <string name="woop_plan_hint">План. Если появится препятствие, ты делаешь одно конкретное действие.</string>
    <string name="woop_your_obstacle">Твоё препятствие</string>
    <string name="woop_add_first_plan">Составить план «если–то»</string>
    <string name="woop_add_plan">Добавить ещё план</string>
    <string name="woop_plans">Планы «если–то»</string>
    <string name="woop_new_plan">Новый план «если–то»</string>
    <string name="woop_edit_plan">План «если–то»</string>
    <string name="woop_if">Если…</string>
    <string name="woop_if_hint">появится препятствие</string>
    <string name="woop_then">То я…</string>
    <string name="woop_then_hint">одно конкретное действие</string>
    <string name="woop_if_short">Если</string>
    <string name="woop_then_short">То я</string>
    <string name="woop_then_missing">Допиши, что ты сделаешь</string>

    <!-- GROW -->
    <string name="grow_goal">Чего ты хочешь добиться?</string>
    <string name="grow_goal_hint">Цель. И каким был бы хороший итог этого разговора?</string>
    <string name="grow_goal_example">найти способ тренироваться регулярно при плотной работе</string>
    <string name="grow_reality">Где ты сейчас?</string>
    <string name="grow_reality_hint">Реальность. Факты, без оценок.</string>
    <string name="grow_reality_prompts">Что происходит сейчас? Что уже сделано и что из этого вышло? Что мешает? Что у тебя есть такого, что может помочь?</string>
    <string name="grow_options">Что можно сделать?</string>
    <string name="grow_options_hint">Варианты. Выпиши побольше, даже странные. Пока не оценивай.</string>
    <string name="grow_option_hint">Вариант</string>
    <string name="grow_options_empty">Постарайся набрать хотя бы пять.</string>
    <string name="grow_options_choose">Отметь звездой варианты, которые выбираешь.</string>
    <string name="grow_will">Что ты сделаешь и когда?</string>
    <string name="grow_will_hint">Воля. Преврати выбранные варианты в шаги с датой или расписанием.</string>
    <string name="grow_will_empty">Сначала выбери вариант или сразу добавь шаг.</string>
