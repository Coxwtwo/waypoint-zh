    <!-- Quiz -->
    <string name="quiz_title">哪种方法适合？</string>
    <string name="quiz_step">第 %1$d / %2$d 题</string>
    <string name="quiz_q1">你的目标是什么样的？</string>
    <string name="quiz_q1_dream">一个有很多面向的大梦想</string>
    <string name="quiz_q1_number">一个我能衡量的结果</string>
    <string name="quiz_q1_habit">一个新习惯或练习</string>
    <string name="quiz_q1_project">一个有截止日期的项目</string>
    <string name="quiz_q1_unsure">我还不确定自己想要什么</string>
    <string name="quiz_q2">你能用数字衡量它吗？</string>
    <string name="quiz_q2_yes">能：公斤、金钱、页数、分钟</string>
    <string name="quiz_q2_no">不太能</string>
    <string name="quiz_q3">它离现在有多远？</string>
    <string name="quiz_q3_weeks">几周</string>
    <string name="quiz_q3_quarter">大约三个月</string>
    <string name="quiz_q3_year">一年或更久</string>
    <string name="quiz_q4">通常是什么阻碍了你？</string>
    <string name="quiz_q4_focus">我会因为别的事分心</string>
    <string name="quiz_q4_delay">我会拖延</string>
    <string name="quiz_q4_give_up">遇到困难我就放弃</string>
    <string name="quiz_q4_overwhelm">一切都让人不堪重负</string>
    <string name="quiz_q4_start">我不知道从哪里开始</string>
    <string name="quiz_q5">你喜欢多少结构化的安排？</string>
    <string name="quiz_q5_lot">很多：计划、数字、检视</string>
    <string name="quiz_q5_little">一点：越轻越好</string>

    <string name="quiz_result_title">这两种最适合你</string>
    <string name="quiz_best">最佳匹配</string>
    <string name="quiz_because">为什么：%s。</string>
    <string name="quiz_start_with">从 %s 开始</string>
    <string name="quiz_about">关于它</string>
    <string name="quiz_again">再做一次测验</string>
    <string name="quiz_tools_title">先选择目标</string>
    <string name="quiz_tools_text">当目标本身还不清晰时，方法帮不上忙。这些工具帮你找到你真正想要的。</string>
    <string name="quiz_or_start">或者立即开始</string>
    <string name="quiz_lens_title">添加一个视角</string>
    <string name="quiz_lens_woop">如果你容易放弃或拖延，WOOP 会为那个时刻准备一份「如果—那么」计划。</string>
    <string name="quiz_lens_smart">清晰的表述先行。SMART 把模糊的愿望变成一个可检验的目标。</string>
    <string name="quiz_lens_premortem">长路漫漫，处处可能跌倒。事前验尸能提前找到它们。</string>
    <string name="quiz_lens_whys">在长路上，记得当初为什么出发会有帮助。五个为什么找到真正的理由。</string>

    <string name="quiz_why_dream">当整幅图景浓缩在一页纸上时，一个大目标会更容易</string>
    <string name="quiz_why_number">你的结果是一个数字，而这个方法正是围绕数字构建的</string>
    <string name="quiz_why_habit">练习靠每天的小步成长得最好</string>
    <string name="quiz_why_project">有截止日期的项目最适合从终点倒推规划</string>
    <string name="quiz_why_unsure">它足够轻巧，可以在目标还在成形时就起步</string>
    <string name="quiz_why_measurable">你可以衡量它，所以能用数字看到进展</string>
    <string name="quiz_why_not_measurable">它很适合那些难以用数字衡量的目标</string>
    <string name="quiz_why_weeks">它适合几周的短周期</string>
    <string name="quiz_why_quarter">它是为大约三个月设计的</string>
    <string name="quiz_why_year">它经得起一年或更久的漫漫长路</string>
    <string name="quiz_why_focus">当注意力游移时，它让你专注于一件事</string>
    <string name="quiz_why_delay">临近的截止日期让你没空间拖延</string>
    <string name="quiz_why_give_up">小步难以放弃</string>
    <string name="quiz_why_overwhelm">它把大目标拆成不让人喘不过气的小块</string>
    <string name="quiz_why_start">它明确告诉你先做什么</string>
    <string name="quiz_why_structured">它给你喜欢的结构化安排</string>
    <string name="quiz_why_light">它保持轻松，正如你喜欢的那样</string>
</resources>
