    <!-- Wheel of life -->
    <string name="wheel_intro">按今天的实际状态，给生活的每个领域从 1 到 10 打分，而不是按它「应该」的样子。没有错误答案。</string>
    <string name="wheel_average">平均 %s</string>
    <string name="wheel_comparing">轮廓：%1$s 的评估，平均 %2$s</string>
    <string name="wheel_rate">现在怎么样？</string>
    <string name="wheel_save">保存这次评估</string>
    <string name="wheel_saved">今天已保存</string>
    <string name="wheel_lowest">目标最能帮上忙的地方</string>
    <string name="wheel_lowest_text">得分最低的领域。即使在这里定一个小目标，也能撬动整个轮子。</string>
    <string name="wheel_score">%d / 10</string>
    <string name="wheel_goal_here">设定一个目标</string>
    <string name="wheel_history">过去的评估</string>
    <string name="wheel_history_hint">点按一次评估，与上方的轮子对比。</string>

    <!-- Odyssey plans -->
    <string name="ody_intro">想象未来五年的三种不同版本。别找「正确」的那个：每一种都是真实的可能性。</string>
    <string name="ody_life_n">人生 %d</string>
    <string name="ody_life1">你正在走的路</string>
    <string name="ody_life2">如果这条路消失了</string>
    <string name="ody_life3">如果金钱无关紧要</string>
    <string name="ody_life1_text">你现在做的事，五年后会通向哪里？细致地想象一下。</string>
    <string name="ody_life2_text">你现在的路突然被堵死了。你会改做什么？</string>
    <string name="ody_life3_text">金钱、地位和别人的眼光都不重要。你会怎么生活？</string>
    <string name="ody_sketch">勾勒这种人生</string>
    <string name="ody_headline">标题</string>
    <string name="ody_headline_hint">用六个字概括这种人生</string>
    <string name="ody_story">五年里会发生什么</string>
    <string name="ody_story_hint">工作、家庭、人、你学到的东西</string>
    <string name="ody_resources">资源</string>
    <string name="ody_like">我喜欢</string>
    <string name="ody_confidence">信心</string>
    <string name="ody_coherence">一致性</string>
    <string name="ody_compare">并排对比</string>
    <string name="ody_total">平均 %d</string>
    <string name="ody_compare_hint">人生 %d 得分最高。不过分数不是判决：留意你总是不由自主想起哪一种人生。</string>
    <string name="ody_delete">删除这种人生？</string>
    <string name="ody_delete_text">这份勾勒和它的评分都会被删除。</string>

    <!-- 5/25 -->
    <string name="buf_intro">写下你想要的 25 件事，不论大小。然后挑出最重要的五个。</string>
    <string name="buf_written">已写下 %1$d / %2$d</string>
    <string name="buf_chosen">已选中 %1$d / %2$d</string>
    <string name="buf_add">添加目标</string>
    <string name="buf_empty">开始列清单吧。任何你想要的都算：工作上的、生活里的、为你自己的。</string>
    <string name="buf_top">最重要的五个</string>
    <string name="buf_top_empty">点按目标旁边的星星，把它选入前五。</string>
    <string name="buf_top_full">前五已满。先移除一颗星。</string>
    <string name="buf_list">其他一切</string>
    <string name="buf_list_text">点按星星，把目标选入前五。</string>
    <string name="buf_avoid">不惜一切代价避开</string>
    <string name="buf_avoid_text">这些不是备选清单。它们刚好重要到会偷走前五的时间，所以暂时别碰。</string>
    <string name="buf_new">新目标</string>
    <string name="buf_edit">编辑目标</string>
    <string name="buf_hint">你想要什么？</string>
    <string name="buf_choose">选入前五</string>
    <string name="buf_unchoose">从前五移除</string>
    <string name="buf_delete">删除这个目标？</string>
    <string name="buf_delete_text">它会从清单中移除。</string>

    <!-- Dreamline -->
    <string name="dream_intro">写下你的梦想，给它标个价。很多梦想其实比看上去更便宜。</string>
    <string name="dream_having">拥有</string>
    <string name="dream_being">成为</string>
    <string name="dream_doing">做到</string>
    <string name="dream_having_hint">东西：一把吉他、海边的一套公寓、一辆好自行车</string>
    <string name="dream_being_hint">你想成为的人：西班牙语流利、厨艺高超</string>
    <string name="dream_doing_hint">体验：看极光、跑一场马拉松</string>
    <string name="dream_tmi">目标月收入</string>
    <string name="dream_tmi_text">一次性开销分摊到 %d 个月，加上每月开销，再加 30%% 应对意外。</string>
