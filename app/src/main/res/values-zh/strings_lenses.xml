    <!-- SMART -->
    <string name="smart_s">你究竟想要什么？</string>
    <string name="smart_s_hint">具体。谁、什么、哪里。把模糊的词换成具体的词。</string>
    <string name="smart_s_example">在我所在的城市跑一场马拉松，而不只是「健身」</string>
    <string name="smart_m">你如何知道自己做到了？</string>
    <string name="smart_m_hint">可衡量。一个数字、一个事实、一个你能核验的东西。</string>
    <string name="smart_m_example">4 小时内跑完 42.2 公里</string>
    <string name="smart_a">以你现有的条件，现实吗？</string>
    <string name="smart_a_hint">可实现。时间、金钱、健康、技能。什么能让它可行？</string>
    <string name="smart_a_example">我已经能跑 10 公里，还有 6 个月和每周 4 个早晨</string>
    <string name="smart_r">为什么是它，为什么是现在？</string>
    <string name="smart_r_hint">相关。它如何融入你的生活和其他目标。</string>
    <string name="smart_r_example">我想向自己证明，我能把开始的事做完</string>
    <string name="smart_t">什么时候之前？</string>
    <string name="smart_t_hint">有时限。一个日期让它变得真实，你可以把它设为目标的截止日期。</string>
    <string name="smart_t_example">4 月 20 日的城市马拉松</string>
    <string name="smart_meter">已回答 %d / 5</string>
    <string name="smart_deadline">目标截止日期</string>
    <string name="smart_no_deadline">未设置</string>
    <string name="smart_set_deadline">设定截止日期</string>
    <string name="smart_change_deadline">修改截止日期</string>
    <string name="smart_wording">现在用一句话概括</string>
    <string name="smart_wording_hint">把答案整合成一句清晰的话。</string>
    <string name="smart_wording_placeholder">目标，清楚地写下</string>
    <string name="smart_wording_example">4 小时内跑完 4 月 20 日的城市马拉松</string>
    <string name="smart_use_title">用作目标标题</string>
    <string name="smart_is_title">现在这就是目标的标题了。</string>

    <!-- WOOP -->
    <string name="woop_wish">你想要什么？</string>
    <string name="woop_wish_hint">愿望。有挑战但有可能的事。几个字就够了。</string>
    <string name="woop_wish_example">跑我的第一场马拉松</string>
    <string name="woop_outcome">最好的结果会是什么？</string>
    <string name="woop_outcome_hint">结果。它会带来什么感受，什么会改变？</string>
    <string name="woop_outcome_pause">花一分钟。闭上眼睛，尽可能生动地想象最好的结果：你在哪里、看到什么、感受如何。然后写下来。</string>
    <string name="woop_outcome_example">冲过终点线，家人在欢呼，我感到自己能做成难事</string>
    <string name="woop_obstacle">你内心的什么可能挡路？</string>
    <string name="woop_obstacle_hint">障碍。不是天气或别人，而是你的一个习惯、一种情绪、一个念头。</string>
    <string name="woop_obstacle_pause">现在想象通常出问题的那个时刻。那一刻你感觉到或想到什么？说出主要障碍。</string>
    <string name="woop_obstacle_example">下班后我很累，告诉自己明天再跑</string>
    <string name="woop_plan">它出现时你会怎么做？</string>
    <string name="woop_plan_hint">计划。如果障碍出现，那么你就做一件具体的事。</string>
    <string name="woop_your_obstacle">你的障碍</string>
    <string name="woop_add_first_plan">制定一个「如果—那么」计划</string>
    <string name="woop_add_plan">再添加一个计划</string>
    <string name="woop_plans">「如果—那么」计划</string>
    <string name="woop_new_plan">新「如果—那么」计划</string>
    <string name="woop_edit_plan">「如果—那么」计划</string>
    <string name="woop_if">如果……</string>
    <string name="woop_if_hint">障碍出现</string>
    <string name="woop_then">那么我就……</string>
    <string name="woop_then_hint">一件具体的行动</string>
    <string name="woop_if_short">如果</string>
    <string name="woop_then_short">那么我就</string>
