    <!-- Methods: name, short badge, one-line tagline, what it is, steps (one per line), where it comes from -->
    <string name="m_mandala">曼陀罗 64</string>
    <string name="m_mandala_short">曼陀罗 64</string>
    <string name="m_mandala_tag">一个目标、8 根支柱、64 项行动，一张表搞定</string>
    <string name="m_mandala_about">一张 9×9 的图表。目标在正中央，四周环绕八根支柱，每根支柱配八项具体行动，共 64 项。整条路浓缩在一页纸上，网格推着你跳出显而易见的答案。大谷翔平的图表里，投球速度旁边写着「运气」和「受人喜欢」。</string>
    <string name="m_mandala_how">在中央写下目标。\n说出八根支柱：要走到那一步，什么必须成立。\n给每根支柱配八项具体行动。\n有些做成习惯，有些当成一次性步骤来完成。\n当一项行动成为你的一部分时，点亮一颗星。</string>
    <string name="m_mandala_origin">日本教练原田隆史的原田法。因大谷翔平而闻名——他 16 岁时填了这样一张表，目标是被八支球队首轮选中。</string>

    <string name="m_okr">OKR</string>
    <string name="m_okr_short">OKR</string>
    <string name="m_okr_tag">一个鼓舞人心的目标，加上证明它的数字</string>
    <string name="m_okr_about">一个让你兴奋的目标，加上三到五个用数字衡量的关键结果。周期为一个季度，评分从 0 到 1。对于一个雄心勃勃的目标，0.7 已经算成功。</string>
    <string name="m_okr_how">用文字写下目标，而不是数字。\n添加 3–5 个关键结果，每个都有起点和目标值。\n列出行动举措：你会做什么来推动数字。\n每周检视：更新数字和你的信心。\n季度末打分。</string>
    <string name="m_okr_origin">1970 年代英特尔公司的安迪·格鲁夫。1999 年约翰·杜尔把它带到谷歌，从此风靡全球。</string>

    <string name="m_weeks12">12 周完成一年工作</string>
    <string name="m_weeks12_short">12 周</string>
    <string name="m_weeks12_tag">把一年压缩成 12 周，每周打分</string>
    <string name="m_weeks12_about" formatted="false">把 12 周当作一整年。截止日期永远近在眼前，所以没时间拖延。每周你给自己打分，看计划的战术完成了多少。85% 就算优秀：你能掌控的是执行，而不是结果。</string>
    <string name="m_weeks12_how" formatted="false">决定你在 12 周内要达成什么。\n把它拆成每周的战术。\n每天执行并打勾。\n每周打分，目标 85%。\n第 13 周用来回顾和休息。</string>
    <string name="m_weeks12_origin">出自布莱恩·莫兰和迈克尔·伦宁顿的书《用12周完成12月的工作》。</string>

    <string name="m_fourdx">4DX</string>
    <string name="m_fourdx_short">4DX</string>
    <string name="m_fourdx_tag">一个关键目标、驱动它的行动、一块记分板</string>
    <string name="m_fourdx_about">一个至关重要的目标，带一个滞后指标：从 X 到 Y，在何时之前。加上一到两个领先指标：你完全可控、能推动结果达成的行动。一块简单的记分板每周告诉你是否领先。</string>
    <string name="m_fourdx_how">选一个至关重要的目标：从 X 到 Y，在某个日期前。\n选 1–2 个领先指标，它们能预测结果且取决于你。\n维护记分板：这周你领先了吗？\n每周：回顾，再对下周做出承诺。</string>
    <string name="m_fourdx_origin">《高效能人士的执行 4 原则》，作者克里斯·麦克切斯尼、肖恩·柯维、吉姆·胡林，出自富兰克林柯维。</string>

    <string name="m_kaizen" formatted="false">每天 1%</string>
    <string name="m_kaizen_short">改善</string>
    <string name="m_kaizen_tag">每天多一点，积少成多</string>
    <string name="m_kaizen_about">从小处开始，每天增加一点。每天 1% 看似微不足道，却会复利增长：70 天后就翻倍。适用于任何你能计数的事情：俯卧撑、页数、分钟、字数。</string>
    <string name="m_kaizen_how" formatted="false">选择要培养什么，定一个轻松的起始数字。\n设定每日步长：1% 或你自己的比例。\n每天完成当天的数字并记录。\n看着曲线攀升。</string>
    <string name="m_kaizen_origin" formatted="false">Kaizen 是日本持续改进的实践。詹姆斯·克利尔在《原子习惯》里让「每天进步 1%」这个理念家喻户晓。</string>

    <string name="m_pact">30 天约定</string>
    <string name="m_pact_short">约定</string>
    <string name="m_pact_tag">不是目标，而是一场实验：先试 30 天</string>
    <string name="m_pact_about">不是目标，而是一场实验：「我要做 X，坚持 30 天。」没有必须达成的结果。你守住约定，静观其变。最后再决定：继续、暂停还是转向。</string>
    <string name="m_pact_how">写下约定：我要……坚持……天。\n每天守住约定就打个勾。\n记录途中的观察。\n最后决定：继续、暂停还是转向。</string>
    <string name="m_pact_origin">出自神经科学家安妮-洛尔·勒坎夫的《小实验》。PACT 代表 purposeful（有目的）、actionable（可行动）、continuous（持续）、trackable（可追踪）。</string>

    <string name="m_ladder">倒推计划</string>
    <string name="m_ladder_short">倒推计划</string>
    <string name="m_ladder_tag">从终点出发，一步步走回今天</string>
    <string name="m_ladder_about">从终点出发，倒着走：一个月前必须完成什么？再往前呢？一直走到你能在本周迈出的一步。最终得到一份带日期的计划，正好落在你的目标上。</string>
    <string name="m_ladder_how">写下目标和日期。\n问：在那之前必须完成什么？\n一直倒推到今天。\n给每一步定一个日期。\n一级一级地往上爬。</string>
    <string name="m_ladder_origin">倒推法（Backcasting），自 1970 年代起用于战略和长期规划。</string>

    <string name="m_simple">里程碑</string>
    <string name="m_simple_short">里程碑</string>
    <string name="m_simple_tag">一个目标、几个检查点和习惯，别无其他</string>
    <string name="m_simple_about">一个目标配几个里程碑，需要的话再加上习惯。适用于完整方法反而过于繁重的场合。</string>
    <string name="m_simple_how">说出目标，如果愿意也可以写下一个要达到的数字。\n沿途添加里程碑。\n添加推动你前进的习惯。</string>
    <string name="m_simple_origin">世上最古老的方法。</string>

    <string name="m_tracker">进度追踪</string>
    <string name="m_tracker_short">追踪</string>
    <string name="m_tracker_tag">可计数的任务，一次 + 一下</string>
    <string name="m_tracker_about">把目标拆成可以计数的任务：课程、页数、题目、公里。每个任务有总量、单位和每次增加的量。在今天点 + 推进，点 - 撤销，看着进度条一点点填满。</string>
    <string name="m_tracker_how">说出构成目标的任务。\n给每个任务设总量、单位和增量。\n可选地设定计划和日期范围。\n每完成一块就在今天点 +。\n点 - 撤销最近一次。</string>
    <string name="m_tracker_origin">可衡量目标最简单的习惯：把所做的事一点点数清楚。</string>

    <string name="m_smart">SMART</string>
    <string name="m_smart_short">SMART</string>
    <string name="m_smart_tag">把愿望变成一个清晰、可检验的目标</string>
    <string name="m_smart_about">五个问题，把模糊的愿望变成目标：它是否具体（specific）、可衡量（measurable）、可实现（achievable）、相关（relevant）、有时限（time-bound）？通过全部五条的目标，连一个月后的你自己都很难误解。</string>
    <string name="m_smart_how">具体：究竟是什么？\n可衡量：你如何知道自己做到了？\n可实现：以你现有的条件现实吗？\n相关：为什么是它，为什么是现在？\n有时限：什么时候之前？</string>
    <string name="m_smart_origin">乔治·T·多兰，1981 年的一篇管理学文章。</string>

    <string name="m_woop">WOOP</string>
    <string name="m_woop_short">WOOP</string>
    <string name="m_woop_tag">愿望、结果、障碍、计划：带着安全网去梦想</string>
    <string name="m_woop_about">单靠积极想象反而可能降低你的行动力。WOOP 加入了诚实的部分：说出内心的障碍，并为它准备一份「如果—那么」计划。它是经过最多研究验证的坚持到底的技巧之一。</string>
    <string name="m_woop_how">愿望：你想要什么？\n结果：生动地想象最好的结果。\n障碍：内心的什么可能会挡路？\n计划：如果障碍出现，那么我就……</string>
    <string name="m_woop_origin">心理学家加布里埃尔·厄廷根，基于二十年的心理对照与执行意图研究。</string>

    <string name="m_grow">GROW</string>
    <string name="m_grow_short">GROW</string>
    <string name="m_grow_tag">与自己来一场教练对话</string>
    <string name="m_grow_about">一场可以独自进行的教练对话。不急着跳到计划，先诚实地看清自己身处何方，列出各种选项，再做出选择。</string>
    <string name="m_grow_how">目标：你想要什么？\n现状：你现在在哪？试过什么？\n选项：你能做什么？多列几个。\n意愿：你会做什么，什么时候做？</string>
    <string name="m_grow_origin">教练格雷厄姆·亚历山大与约翰·惠特莫尔，1980 年代。</string>

    <string name="m_whys">五个为什么</string>
    <string name="m_whys_short">五个为什么</string>
    <string name="m_whys_tag">挖到那个让你坚持下去的理由</string>
    <string name="m_whys_about">问自己五次「这件事为什么重要？」。每个答案都更深入一层，最后一个就是你真正的动力。在你想放弃的日子里读它。</string>
    <string name="m_whys_how">写下这个目标为什么重要。\n问：「那这又为什么重要？」\n重复五次。\n把最深的答案留在身边。</string>
    <string name="m_whys_origin">丰田的丰田佐吉，用来寻找问题的根本原因。</string>

    <string name="m_premortem">事前验尸</string>
    <string name="m_premortem_short">事前验尸</string>
    <string name="m_premortem_tag">想象它已经失败，再确保它不会</string>
    <string name="m_premortem_about">想象已经到了截止日期，目标失败了。为什么？提前讲述失败的故事，会暴露出乐观情绪掩盖的风险。针对每个风险，写下如何预防。</string>
    <string name="m_premortem_how">想象截止日期已过，事情没有成功。\n写下每一个原因。\n对每一个原因，决定如何预防。\n把计划放在手边，复盘时对照检查。</string>
    <string name="m_premortem_origin">心理学家加里·克莱因，《哈佛商业评论》2007 年。</string>

    <string name="m_wheel">生命之轮</string>
    <string name="m_wheel_short">生命之轮</string>
    <string name="m_wheel_tag">看清生活哪个领域最需要你</string>
    <string name="m_wheel_about">给生活的八个领域从 1 到 10 打分。轮子一眼就能看出哪些领域偏弱，在那里定一个目标改变最大。每隔几个月重复一次并对比。</string>
    <string name="m_wheel_how">诚实地给每个领域从 1 到 10 打分。\n找出轮子上的凹陷处。\n挑一个领域去努力。\n几个月后再检查一次。</string>
    <string name="m_wheel_origin">通常归功于保罗·J·迈耶，Success Motivation Institute 创始人，1960 年代。</string>

    <string name="m_odyssey">奥德赛计划</string>
    <string name="m_odyssey_short">奥德赛</string>
    <string name="m_odyssey_tag">未来五年的三种不同版本</string>
    <string name="m_odyssey_about">勾勒未来五年的三种不同版本：你正在走的人生；如果这条路消失了的人生；以及如果金钱和他人眼光都不重要的人生。给每个版本打分。目标往往会自己浮现。</string>
    <string name="m_odyssey_how">人生 1：你已经在走的路。\n人生 2：如果这条路明天消失。\n人生 3：如果金钱和他人眼光都不重要。\n给每个版本打分：资源、喜爱程度、信心、一致性。\n把吸引你的东西变成一个目标。</string>
    <string name="m_odyssey_origin">比尔·伯内特与戴夫·埃文斯，《斯坦福大学人生设计课》，一门斯坦福课程和同名书籍。</string>

    <string name="m_buffett">5 / 25</string>
    <string name="m_buffett_short">5/25</string>
    <string name="m_buffett_tag">写下 25 个目标，保留 5 个，避开另外 20 个</string>
    <string name="m_buffett_about">写下你想要的 25 件事。选出最重要的五个。另外 20 个不是备选清单，而是「不惜一切代价避开」的清单，因为它们会悄悄偷走那五个的时间。</string>
    <string name="m_buffett_how">写下 25 个目标。\n选出最重要的五个。\n其余的放进避开清单。\n把那五个变成目标。</string>
    <string name="m_buffett_origin">经由沃伦·巴菲特的飞行员讲述的一个故事，被归于巴菲特名下。巴菲特说这不是他的，但这个想法依然奏效。</string>

    <string name="m_dreamline">梦想清单</string>
    <string name="m_dreamline_short">梦想清单</string>
    <string name="m_dreamline_tag">给梦想标上价格，它们就成了计划</string>
    <string name="m_dreamline_about">把梦想分成三列列出来：拥有、成为、做到。给每个标上价格：一次性或按月。把它们加总成目标月收入，「有朝一日」就变成了一个可以规划的数字。</string>
    <string name="m_dreamline_how">列出你想拥有、成为和做到的事。\n给每个梦想标价：一次性，还是按月。\n看看你的目标月收入。\n把最早能实现的梦想变成目标。</string>
    <string name="m_dreamline_origin">蒂姆·费里斯，《每周工作 4 小时》。</string>

