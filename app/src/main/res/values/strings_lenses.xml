    <string name="grow_goal">What do you want to achieve?</string>
    <string name="grow_goal_hint">Goal. And what would a good result of this session be?</string>
    <string name="grow_goal_example">find a way to train regularly despite a busy job</string>
    <string name="grow_reality">Where are you now?</string>
    <string name="grow_reality_hint">Reality. Facts, not judgements.</string>
    <string name="grow_reality_prompts">What is happening now? What have you already tried, and what came of it? What is stopping you? What do you have that could help?</string>
    <string name="grow_options">What could you do?</string>
    <string name="grow_options_hint">Options. Write down many, even odd ones. Don’t judge yet.</string>
    <string name="grow_option_hint">An option</string>
    <string name="grow_options_empty">Aim for at least five.</string>
    <string name="grow_options_choose">Tap the star next to the options you’ll go with.</string>
    <string name="grow_will">What will you do, and when?</string>
    <string name="grow_will_hint">Will. Turn the chosen options into steps with a day or a schedule.</string>
    <string name="grow_will_empty">Choose an option first, or add a step right away.</string>
    <string name="grow_to_action">Turn into a step</string>
    <string name="grow_another_action">Add a step</string>
    <string name="grow_new_action">New step</string>
    <string name="grow_on_today">Steps with a day or a schedule show up on Today.</string>
    <string name="grow_new_step">New step</string>
    <string name="grow_edit_step">Step</string>
    <string name="grow_step_label">What will you do?</string>
    <string name="grow_step_hint">A concrete action</string>
    <string name="grow_choose">Choose this option</string>

    <!-- 5 whys -->
    <string name="whys_depth">Depth %d of 5</string>
    <string name="whys_first">Why does “%s” matter to you?</string>
    <string name="whys_first_hint">Answer honestly, the way you would to a close friend.</string>
    <string name="whys_next">And why does that matter?</string>
    <string name="whys_because">Because…</string>
    <string name="whys_deep">Your deep why</string>
    <string name="whys_deep_text">This is the reason underneath. Read it on the days you want to give up.</string>
    <string name="whys_on_card">It’s on the goal card.</string>
    <string name="whys_put_on_card">Put it on the goal card</string>
    <string name="whys_keep_going">Go a little deeper. The real reason is usually three or four answers down.</string>

