    <!-- SMART -->
    <string name="smart_s_letter" translatable="false">S</string>
    <string name="smart_m_letter" translatable="false">M</string>
    <string name="smart_a_letter" translatable="false">A</string>
    <string name="smart_r_letter" translatable="false">R</string>
    <string name="smart_t_letter" translatable="false">T</string>
    <string name="smart_s">What exactly do you want?</string>
    <string name="smart_s_hint">Specific. Who, what, where. Swap vague words for concrete ones.</string>
    <string name="smart_s_example">run a marathon in my city, not just “get fit”</string>
    <string name="smart_m">How will you know you’re there?</string>
    <string name="smart_m_hint">Measurable. A number, a fact, something you can check.</string>
    <string name="smart_m_example">finish 42.2 km in under 4 hours</string>
    <string name="smart_a">Is it realistic with what you have?</string>
    <string name="smart_a_hint">Achievable. Time, money, health, skills. What would make it doable?</string>
    <string name="smart_a_example">I already run 10 km, and I have 6 months and 4 mornings a week</string>
    <string name="smart_r">Why this, and why now?</string>
    <string name="smart_r_hint">Relevant. How it fits your life and your other goals.</string>
    <string name="smart_r_example">I want to prove to myself that I can finish what I start</string>
    <string name="smart_t">By when?</string>
    <string name="smart_t_hint">Time-bound. A date makes it real, and you can set it as the goal’s deadline.</string>
    <string name="smart_t_example">the city marathon on 20 April</string>
    <string name="smart_meter">%d of 5 answered</string>
    <string name="smart_deadline">Goal deadline</string>
    <string name="smart_no_deadline">Not set</string>
    <string name="smart_set_deadline">Set the deadline</string>
    <string name="smart_change_deadline">Change the deadline</string>
    <string name="smart_wording">Now in one sentence</string>
    <string name="smart_wording_hint">Put the answers together into one clear sentence.</string>
    <string name="smart_wording_placeholder">The goal, clearly</string>
    <string name="smart_wording_example">Run the city marathon on 20 April in under 4 hours</string>
    <string name="smart_use_title">Use as the goal title</string>
    <string name="smart_is_title">This is the goal’s title now.</string>

    <!-- WOOP -->
    <string name="woop_w_letter" translatable="false">W</string>
    <string name="woop_o_letter" translatable="false">O</string>
    <string name="woop_p_letter" translatable="false">P</string>
    <string name="woop_wish">What do you wish for?</string>
    <string name="woop_wish_hint">Wish. Something challenging but possible. A few words are enough.</string>
    <string name="woop_wish_example">run my first marathon</string>
    <string name="woop_outcome">What would be the best result?</string>
    <string name="woop_outcome_hint">Outcome. How will it feel, what will change?</string>
    <string name="woop_outcome_pause">Take a minute. Close your eyes and picture the best outcome as vividly as you can: where you are, what you see, how you feel. Then write it down.</string>
    <string name="woop_outcome_example">crossing the finish line, my family cheering, feeling I can do hard things</string>
    <string name="woop_obstacle">What inside you could get in the way?</string>
    <string name="woop_obstacle_hint">Obstacle. Not the weather or other people: a habit, a feeling, a thought of yours.</string>
    <string name="woop_obstacle_pause">Now picture the moment it usually goes wrong. What do you feel or think right then? Name the main obstacle.</string>
    <string name="woop_obstacle_example">after work I’m tired and tell myself I’ll run tomorrow</string>
    <string name="woop_plan">What will you do when it shows up?</string>
    <string name="woop_plan_hint">Plan. If the obstacle appears, then you do one concrete thing.</string>
    <string name="woop_your_obstacle">Your obstacle</string>
    <string name="woop_add_first_plan">Make an if-then plan</string>
    <string name="woop_add_plan">Add another plan</string>
    <string name="woop_plans">If-then plans</string>
    <string name="woop_new_plan">New if-then plan</string>
    <string name="woop_edit_plan">If-then plan</string>
    <string name="woop_if">If…</string>
    <string name="woop_if_hint">the obstacle shows up</string>
    <string name="woop_then">Then I will…</string>
    <string name="woop_then_hint">one concrete action</string>
    <string name="woop_if_short">If</string>
    <string name="woop_then_short">Then I will</string>
    <string name="woop_then_missing">Add what you will do</string>

    <!-- GROW -->
    <string name="grow_g_letter" translatable="false">G</string>
    <string name="grow_r_letter" translatable="false">R</string>
